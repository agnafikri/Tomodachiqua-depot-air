# Salin file ini menjadi backend/.env lalu isi. Jangan pernah di-commit.

NODE_ENV=development
PORT=4000
TZ=Asia/Jakarta

# Dari Neon: Connection string (berawalan postgresql://, berakhiran ?sslmode=require)
DATABASE_URL=

# Rahasia acak minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Alamat frontend. Lokal: http://localhost:5173. Produksi: domain Cloudflare Pages.
CORS_ORIGIN=http://localhost:5173

# Lama sesi login sejak masuk, dalam jam (24 = 1 hari)
SESSION_HOURS=24

# Akun awal untuk `npm run seed` (password minimal 8 karakter)
SEED_ADMIN_NAME=Agna
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_PEMILIK_NAME=Abah
SEED_PEMILIK_USERNAME=
SEED_PEMILIK_PASSWORD=
